# Публічна базова URL сайту (використовується для canonical, OpenGraph, sitemap).
NEXT_PUBLIC_SITE_URL=https://evodata.com

# Google Analytics 4 (Measurement ID). Якщо не задано — скрипт не підключається.
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID. Якщо не задано — скрипт не підключається.
NEXT_PUBLIC_META_PIXEL_ID=
